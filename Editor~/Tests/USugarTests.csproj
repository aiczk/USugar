    <Compile Include="../../Editor/Compiler/Emit/TypeParamScope.cs" />
    <Compile Include="../../Editor/Compiler/Emit/GenericContext.cs" />
    <Compile Include="../../Editor/Compiler/Emit/EmitPolicy.cs" />
    <Compile Include="../../Editor/Compiler/Emit/TypeClassifier.cs" />
    <Compile Include="../../Editor/Compiler/Emit/BoundaryChecker.cs" />
    <Compile Include="../../Editor/Compiler/Emit/RecursionInfo.cs" />
    <Compile Include="../../Editor/Compiler/Emit/RecursionContext.cs" />
    <Compile Include="../../Editor/Compiler/Emit/ClosureContext.cs" />
    <Compile Include="../../Editor/Compiler/Emit/ReachableBodies.cs" />
    <Compile Include="../../Editor/Compiler/Emit/AggregateLayout.cs" />
    <Compile Include="../../Editor/Compiler/Emit/AggregateContext.cs" />
    <Compile Include="../../Editor/Compiler/Emit/SyntheticContext.cs" />
    <Compile Include="../../Editor/Compiler/Emit/ControlFlowContext.cs" />
    <Compile Include="../../Editor/Compiler/Emit/InitializationContext.cs" />
    <Compile Include="../../Editor/Compiler/Emit/DiagnosticContext.cs" />
    <Compile Include="../../Editor/Compiler/Emit/MethodContext.cs" />
    <Compile Include="../../Editor/Compiler/Emit/StorageContext.cs" />
    <Compile Include="../../Editor/Compiler/Emit/EnvEmit.cs" />
    <Compile Include="../../Editor/Compiler/Emit/TailCallAnalysis.cs" />
    <Compile Include="../../Editor/Compiler/Emit/Analysis/LambdaCaptureAnalyzer.cs" />
    <Compile Include="../../Editor/Compiler/Emit/Analysis/CaptureScopeAnalysis.cs" />
    <Compile Include="../../Editor/Compiler/Emit/IOperationHandler.cs" />
    <Compile Include="../../Editor/Compiler/Emit/IExpressionHandler.cs" />
    <Compile Include="../../Editor/Compiler/Emit/HandlerBase.cs" />
    <Compile Include="../../Editor/Compiler/Emit/HandlerBase.Ndim.cs" />
    <Compile Include="../../Editor/Compiler/Emit/Handlers/StatementHandler.cs" />
