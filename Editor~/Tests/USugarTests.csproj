    <Compile Include="../../Editor/Compiler/Emit/Handlers/OperatorHandler.cs" />
    <Compile Include="../../Editor/Compiler/Emit/Handlers/InvocationHandler.cs" />
    <Compile Include="../../Editor/Compiler/Emit/Handlers/InvocationHandler.Extern.cs" />
    <Compile Include="../../Editor/Compiler/Emit/Handlers/InvocationHandler.Members.cs" />
