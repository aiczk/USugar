<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <!-- Unity 2022.3 compiles Assets code as C# 9.0 against the UdonSharp-bundled Roslyn 3.10:
         every compiler source must parse at that language level AND bind against that API surface.
         This project exists ONLY to fail the headless build when a C# 10+ construct or a
         Roslyn-4.x-only API (e.g. IOperation.ChildOperations) sneaks in. -->
    <LangVersion>9.0</LangVersion>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- RS1024 is audited by USugarTests against the current analyzer. Roslyn 3.10 reports it even
         for target-typed collections that already receive SymbolEqualityComparer.Default. -->
    <NoWarn>$(NoWarn);RS1024</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Editor/Compiler/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="3.10.0" />
  </ItemGroup>
</Project>
